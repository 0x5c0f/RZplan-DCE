# ==============================================================================
# DesignCraftsman Engine (DCE) - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 系统访问授权码 (System Access Key / Passcode)
# ------------------------------------------------------------------------------
# 统一授权口令：用于成员登录鉴权。保护服务端内置模型免遭未授权消耗。
# 自定义设置您的系统口令（若未配置或留空，则内置模型密码访问未开启，访问者只能在前端配置个人大模型）
SYSTEM_ACCESS_KEY="your-custom-secure-passcode"

# ------------------------------------------------------------------------------
# 2. 服务端内置大模型配置 (Built-in LLM Provider - 统一 OpenAI 兼容规范)
# ------------------------------------------------------------------------------
# 登录后用户可免手动配置直接调用此模型。API Key 在服务端严格保密，前端脱敏显示。
# 所有支持 OpenAI 协议的大模型服务（DeepSeek、OpenAI、Gemini等）统一通过此处配置：
#
# [配置示例 A: DeepSeek (推荐，性价比极高)]
# BUILTIN_LLM_PROVIDER="DeepSeek"
# BUILTIN_LLM_BASE_URL="https://api.deepseek.com/v1"
# BUILTIN_LLM_MODEL="deepseek-flash"
# BUILTIN_LLM_API_KEY="sk-..."
#
# [配置示例 B: Google Gemini (通过 Gemini 官方提供的 OpenAI 兼容端点)]
# BUILTIN_LLM_PROVIDER="Google Gemini"
# BUILTIN_LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# BUILTIN_LLM_MODEL="gemini-2.5-flash"
# BUILTIN_LLM_API_KEY="AIzaSy..."
#
# [配置示例 C: OpenAI 原生 / 中转]
# BUILTIN_LLM_PROVIDER="OpenAI"
# BUILTIN_LLM_BASE_URL="https://api.openai.com/v1"
# BUILTIN_LLM_MODEL="gpt-4o-mini"
# BUILTIN_LLM_API_KEY="sk-..."
#
# 默认活动配置：
BUILTIN_LLM_PROVIDER="DeepSeek"
BUILTIN_LLM_BASE_URL="https://api.deepseek.com/v1"
BUILTIN_LLM_MODEL="deepseek-flash"
BUILTIN_LLM_API_KEY=""

# ------------------------------------------------------------------------------
# 3. 服务运行时配置
# ------------------------------------------------------------------------------
PORT=3000
APP_URL="http://localhost:3000"
